# ─────────────────────────────────────────────
# PostgreSQL (Docker local dev)
# ─────────────────────────────────────────────
POSTGRES_USER=rk_kit
POSTGRES_PASSWORD=rk_kit_secret
POSTGRES_DB=rk_kit_dev

# Connection string used by Drizzle + Better Auth
DATABASE_URL=postgresql://rk_kit:rk_kit_secret@localhost:5432/rk_kit_dev

# ─────────────────────────────────────────────
# Better Auth
# ─────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret-here
BETTER_AUTH_URL=http://localhost:3000

# OAuth callback URL pattern (register in each provider dashboard):
#   {BETTER_AUTH_URL}/api/auth/callback/{provider}
# Example: http://localhost:3000/api/auth/callback/github

# ─────────────────────────────────────────────
# OAuth providers (optional — leave empty to keep disabled)
# All providers appear on login/signup; fill in credentials to enable real sign-ins.
# ─────────────────────────────────────────────

# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook — https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Apple — https://developer.apple.com/account/resources/identifiers/list
# Requires Service ID + Sign in with Apple key (.p8)
# Note: Apple does NOT support http://localhost callbacks — use HTTPS in dev (e.g. ngrok)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste .p8 key contents; use \n for line breaks in .env
APPLE_PRIVATE_KEY=
# Optional — required for native iOS ID token flows
APPLE_APP_BUNDLE_IDENTIFIER=

# Microsoft — https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Discord — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# LinkedIn — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─────────────────────────────────────────────
# Email (Brevo — optional)
# Leave BREVO_API_KEY empty to disable real sending (emails are logged instead).
# API key: https://app.brevo.com/settings/keys/api
# Sender must be a verified sender/domain: https://app.brevo.com/senders
# ─────────────────────────────────────────────
BREVO_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=RK Kit

# ─────────────────────────────────────────────
# App (TanStack Start)
# NOTE: Render deployment → bind to 0.0.0.0:$PORT
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
